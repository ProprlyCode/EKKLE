# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the browser.
# Never put secrets (service-role key, email provider key) here — those live
# server-side in Supabase Edge Function secrets.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Links (/r/:slug, QR codes, sign-in) use the page's own address — an account's
# <subdomain>.ekkle.org (or its own domain). Locally: http://<sub>.localhost:5173.
